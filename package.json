{
  "name": "solidity-hiring-screen",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.cjs --network localhost",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --watch",
    "dev": "npm run build:css && node server/index.cjs",
    "prepare": "npm run dev",
    "start": "npm run build:css && node server/index.cjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "express": "^4.21.1",
    "axios": "^1.21.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "hh2",
    "autoprefixer": "^10.4.20",
    "hardhat": "^2.22.17",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
